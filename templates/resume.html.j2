<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{{ resume.get("title", resume["name"] ~ " - Resume") }}</title>

    <style>
    {{ css | safe }}
    </style>
</head>

<body>

    <page size="{{ resume.get("page_size", "Letter") }}">

        <header class="resume-header">
            <h1 class="resume-name">{{ resume["name"] }}</h1>

            {% if resume.get("contact", []) %}
                <ul class="contact-info">
                    {% for contact in resume.get("contact", []) %}
                        <li>
                            {% if contact.get("url", "") %}
                                <a href="{{ contact["url"] }}">
                                    {{ contact["label"] }}
                                </a>
                            {% else %}
                                {{ contact["label"] }}
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </header>

        {% for section in sections %}

            <section class="section">

                <h2 class="section-title">
                    {{ section["title"] }}
                </h2>

                {% if section.get("template", "items") == "items" %}

                    {% for item in section.get("items", []) %}

                        <article class="{{ section.get("item_class", "experience-item") }}">

                            <div class="item-header">

                                <span class="title">
                                    {% if item.get("url", "") %}
                                        <a href="{{ item["url"] }}">
                                            {{ item["title"] }}
                                        </a>
                                    {% else %}
                                        {{ item["title"] }}
                                    {% endif %}
                                </span>

                                {% if item.get("date", "") %}
                                    <span class="date">
                                        {{ item["date"] }}
                                    </span>
                                {% endif %}

                            </div>

                            {% if item.get("subtitle", "") or item.get("location", "") %}

                                <div class="item-subheader">

                                    {% if item.get("subtitle", "") %}
                                        <span class="organization">

                                            {% if item.get("subtitle_url", "") %}
                                                <a href="{{ item["subtitle_url"] }}">
                                                    {{ item["subtitle"] }}
                                                </a>
                                            {% else %}
                                                {{ item["subtitle"] }}
                                            {% endif %}

                                        </span>
                                    {% endif %}

                                    {% if item.get("location", "") %}
                                        <span class="location">
                                            {{ item["location"] }}
                                        </span>
                                    {% endif %}

                                </div>

                            {% endif %}

                            {% if item.get("details", []) %}

                                <ul class="item-details">
                                    {% for detail in item.get("details", []) %}
                                        <li>{{ detail | safe }}</li>
                                    {% endfor %}
                                </ul>

                            {% endif %}

                        </article>

                    {% endfor %}

                {% elif section.get("template", "items") == "skills" %}

                    <div class="skills-list">

                        {% for skill in section.get("items", []) %}

                            <div class="skill-category">

                                <strong>{{ skill["category"] }}</strong>

                                <span class="skill-separator">·</span>

                                <span>{{ skill["skills"] | safe }}</span>

                            </div>

                        {% endfor %}

                    </div>

                {% elif section.get("template", "items") == "text" %}

                    {% if section.get("text", "") %}
                        <p class="section-text">
                            {{ section["text"] | safe }}
                        </p>
                    {% endif %}

                    {% if section.get("items", []) %}
                        <ul class="item-details">
                            {% for item in section.get("items", []) %}
                                <li>{{ item | safe }}</li>
                            {% endfor %}
                        </ul>
                    {% endif %}

                {% else %}

                    {% for item in section.get("items", []) %}

                        <article class="experience-item">

                            <div class="item-header">
                                <span class="title">
                                    {{ item["title"] }}
                                </span>
                            </div>

                            {% if item.get("details", []) %}
                                <ul class="item-details">
                                    {% for detail in item.get("details", []) %}
                                        <li>{{ detail | safe }}</li>
                                    {% endfor %}
                                </ul>
                            {% endif %}

                        </article>

                    {% endfor %}

                {% endif %}

            </section>

            {% if section.get("page_break_after", false) %}
                <div class="page-break"></div>
            {% endif %}

        {% endfor %}

    </page>

</body>

</html>